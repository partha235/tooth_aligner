# to read date and time from RTC module. 
from machine import Pin, I2C
import time

i2c = I2C(
    0,
    scl=Pin(22),
    sda=Pin(21),
    freq=100000
)

RTC_ADDR = 0x68

def bcd_to_dec(val):
    return (val >> 4) * 10 + (val & 0x0F)

while True:
    data = i2c.readfrom_mem(RTC_ADDR, 0x00, 7)

    sec = bcd_to_dec(data[0] & 0x7F)
    minute = bcd_to_dec(data[1])
    hour = bcd_to_dec(data[2] & 0x3F)
    day = bcd_to_dec(data[4])
    month = bcd_to_dec(data[5] & 0x1F)
    year = 2000 + bcd_to_dec(data[6])

    print("{:04d}-{:02d}-{:02d} {:02d}:{:02d}:{:02d}".format(
        year, month, day,
        hour, minute, sec
    ))

    time.sleep(1)