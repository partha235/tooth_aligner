from machine import Pin, I2C

i2c = I2C(
    0,
    scl=Pin(22),
    sda=Pin(21),
    freq=100000
)

RTC_ADDR = 0x68

print("I2C devices:", i2c.scan())

# Read DS3231 status register
status = i2c.readfrom_mem(RTC_ADDR, 0x0F, 1)[0]

print("Status register:", hex(status))

if status & 0x80:
    print("WARNING: Oscillator Stop Flag = SET")
    print("RTC has lost/was interrupted from valid timekeeping.")
else:
    print("Oscillator Stop Flag = CLEAR")

# Read control register
control = i2c.readfrom_mem(RTC_ADDR, 0x0E, 1)[0]

print("Control register:", hex(control))